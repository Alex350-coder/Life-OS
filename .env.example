# Copia este archivo como .env y complétalo. Nunca subas .env a Git.
# Ruta absoluta a la bóveda real de Obsidian, fuera del repositorio.
LIFEOS_VAULT_PATH=
# Zona horaria IANA, p. ej. America/Lima.
LIFEOS_TIMEZONE=
# Clave del catálogo de NVIDIA (ADR-0007). Solo se lee de .env o del entorno; nunca se registra.
NVIDIA_API_KEY=
# Carpeta de logs de uso y auditoría (ADR-0008). Vacío = logs/ dentro de este repositorio.
LIFEOS_LOGS_DIR=
