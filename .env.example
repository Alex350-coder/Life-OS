# Copia este archivo como .env y complétalo. Nunca subas .env a Git.
# Ruta absoluta a la bóveda real de Obsidian, fuera del repositorio.
LIFEOS_VAULT_PATH=
# Zona horaria IANA, p. ej. America/Lima. Opcional; si se indica, debe coincidir con la zona
# de _sistema/horario.md (la planificación usa la del horario; los logs siguen en UTC).
LIFEOS_TIMEZONE=
# Clave del catálogo de NVIDIA (ADR-0007). Solo se lee de .env o del entorno; nunca se registra.
NVIDIA_API_KEY=
# Carpeta de logs de uso y auditoría (ADR-0008). Vacío = logs/ dentro de este repositorio.
LIFEOS_LOGS_DIR=
# Servicio de rituales y Telegram (ADR-0014). Token de @BotFather; nunca se registra.
TELEGRAM_BOT_TOKEN=
# Tu chat (número). Obtenlo con: uv run lifeos-servicio --descubrir
TELEGRAM_OWNER_CHAT_ID=
# Carpeta del estado del servicio. Vacío = state/ dentro de este repositorio.
LIFEOS_STATE_DIR=
# Modelo de transcripción local (ADR-0015): tiny, base, small (por defecto) o medium.
LIFEOS_WHISPER_MODEL=
