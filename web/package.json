{
  "name": "lifeos-web",
  "private": true,
  "version": "0.1.0",
  "description": "Interfaz web local de Life OS (Fase 5, ADR-0012).",
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.engine.json && tsc --noEmit && vite build",
    "typecheck": "tsc -b tsconfig.engine.json && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
